<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyWeather" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Shown until MainActivity knows the saved theme; then it switches to Theme.MyWeather. -->
    <style name="Theme.MyWeather.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyWeather</item>
    </style>
</resources>
